{
  "version": "1.0",
  "name": "blog-example",
  "description": "A blog application with users, posts, comments, and categories",
  "collections": {
    "user": {
      "auth": true,
      "timestamps": true,
      "fields": {
        "email": { "type": "email", "required": true, "unique": true },
        "password_hash": { "type": "text", "required": true },
        "name": { "type": "text", "required": true },
        "avatar": { "type": "file" },
        "bio": { "type": "text", "textarea": true },
        "role": { "type": "enum", "options": ["admin", "author", "reader"], "default": "reader" }
      },
      "permissions": {
        "read": "public",
        "create": "public",
        "update": "self",
        "delete": "admin"
      }
    },
    "post": {
      "timestamps": true,
      "soft_delete": true,
      "fields": {
        "title": { "type": "text", "required": true, "max_length": 200 },
        "slug": { "type": "text", "unique": true },
        "content": { "type": "richtext" },
        "excerpt": { "type": "text", "max_length": 500 },
        "featured_image": { "type": "file" },
        "author": { "type": "relation", "target": "user", "relation": "many-to-one", "required": true },
        "category": { "type": "relation", "target": "category", "relation": "many-to-one" },
        "tags": { "type": "relation", "target": "tag", "relation": "many-to-many" },
        "status": { "type": "enum", "options": ["draft", "published", "archived"], "default": "draft" },
        "published_at": { "type": "datetime" },
        "view_count": { "type": "integer", "default": 0 }
      },
      "hooks": {
        "beforeCreate": ["slugify:title"]
      },
      "api": {
        "default_limit": 10,
        "max_limit": 50,
        "search_fields": ["title", "content", "excerpt"]
      }
    },
    "category": {
      "fields": {
        "name": { "type": "text", "required": true },
        "slug": { "type": "text", "unique": true },
        "description": { "type": "text" },
        "parent": { "type": "relation", "target": "category", "relation": "many-to-one" }
      },
      "hooks": {
        "beforeCreate": ["slugify:name"]
      }
    },
    "tag": {
      "fields": {
        "name": { "type": "text", "required": true, "unique": true },
        "slug": { "type": "text", "unique": true }
      },
      "hooks": {
        "beforeCreate": ["slugify:name"]
      }
    },
    "comment": {
      "timestamps": true,
      "soft_delete": true,
      "fields": {
        "content": { "type": "text", "required": true },
        "post": { "type": "relation", "target": "post", "relation": "many-to-one", "required": true },
        "author": { "type": "relation", "target": "user", "relation": "many-to-one", "required": true },
        "parent": { "type": "relation", "target": "comment", "relation": "many-to-one" },
        "status": { "type": "enum", "options": ["pending", "approved", "spam"], "default": "pending" }
      },
      "permissions": {
        "read": "public",
        "create": "authenticated",
        "update": "owner",
        "delete": "owner"
      }
    }
  }
}
