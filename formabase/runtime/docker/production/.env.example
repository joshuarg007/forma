# Forma Runtime Production Environment
# Copy to .env and fill in values

# =============================================================================
# REQUIRED
# =============================================================================

# Internal key for Builder -> Runtime communication
# Generate with: openssl rand -hex 32
INTERNAL_KEY=your-internal-key-here

# JWT secret for authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here

# PostgreSQL password
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=your-postgres-password-here

# Full database URL (if using external database)
# DATABASE_URL=postgresql://user:password@host:5432/forma_runtime

# =============================================================================
# OPTIONAL
# =============================================================================

# AI Validation (requires Ollama)
AI_VALIDATION_ENABLED=false
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# S3 Storage for file uploads
STORAGE_PROVIDER=local
# S3_BUCKET=forma-uploads
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
